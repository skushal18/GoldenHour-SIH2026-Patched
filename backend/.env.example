# =============================================================================
# GoldenHour backend configuration
#
# Copy to backend/.env and edit. This file is safe to commit; .env is not, and
# .gitignore keeps it out.
#
# The important thing to know: with NODE_ENV=production the server AUDITS this
# configuration at boot and REFUSES TO START if anything here would be unsafe
# in a real deployment. It prints exactly what to change and exits 78. That is
# deliberate — a misconfigured emergency system should fail in the deploy log,
# not quietly in front of patients.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5000

# development (default) | production
# production is a declaration that this instance matters. It turns every
# warning below into a refusal to start.
NODE_ENV=development


# ── Persistence ──────────────────────────────────────────────────────────────
# auto   — try MySQL, fall back to in-memory. Fine for development.
# memory — always in-memory. Cases are lost on every restart.
# mysql  — require MySQL. An unreachable database is a failed start.
#
# Production MUST be mysql. Under "auto", a database outage turns into silent
# data loss that nobody notices until a case vanishes.
DB_DRIVER=auto
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goldenhour


# ── Who a hospital desk is ───────────────────────────────────────────────────
# ip  — LAN/demo. Identity comes from ?hospital=<id> or the client IP. This is
#       a demo mechanism, NOT authentication: anyone can claim to be anyone.
# jwt — production. Identity comes from a signed token issued at login.
DESK_AUTH=ip

# Set false to switch off ?hospital=<id> even in ip mode. Ignored under jwt.
ALLOW_MANUAL_HOSPITAL_OVERRIDE=true

# Signs desk tokens. Generate a real one — never reuse the value below:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production requires at least 32 characters and rejects any value that has
# ever appeared in this repository.
JWT_SECRET=


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Blank means "any origin", which is convenient on a
# LAN and unacceptable in production.
#   CORS_ORIGIN=https://goldenhour.example,https://desk.goldenhour.example
CORS_ORIGIN=


# ── Broadcast behaviour ──────────────────────────────────────────────────────
# true  — every broadcast goes to the two hardcoded demo hospitals.
# false — real hospitals, matched by distance within the crew's radius.
HACKATHON_MODE=true

# How long a broadcast stays open before it expires unanswered.
ACCEPT_WINDOW_SECONDS=180

# Repeat POSTs carrying the same X-Client-Request-Id return the original case
# instead of creating a second one. This is what stops the app's offline
# outbox putting the same patient on two ER boards.
REQUEST_IDEMPOTENCY_TTL_MS=1800000


# ── Live tracking ────────────────────────────────────────────────────────────
TRACK_MIN_INTERVAL_MS=5000     # server-side floor between accepted positions
TRACK_MAX_POINTS=120           # ring buffer per case (~20 min at one per 10 s)
TRACK_STALL_SECONDS=90         # below TRACK_STALL_KMH this long → "not moving"
TRACK_STALL_KMH=5
TRACK_SPEED_MIN_KMH=15         # ETA clamp: a stopped ambulance is not a 4-hour ETA
TRACK_SPEED_MAX_KMH=80         # ETA clamp: a GPS jump is not a 30-second ETA
TRACK_ETA_ROAD_FACTOR=1.25     # straight-line distance → road distance
MAP_TILE_URL=                  # blank = no tiles; set a local /tiles/{z}/{x}/{y}.png for an offline demo


# ── Capacity ─────────────────────────────────────────────────────────────────
CAPACITY_STALE_MINUTES=60      # older than this is penalised in match_score

# true keeps capacity a SOFT gate: it ranks hospitals and warns the desk, but
# never removes a hospital from the fan-out. Setting this false would let a
# stale capacity record hide a patient from a hospital that could have taken
# them. Do not.
CAPACITY_SOFT_GATE=true


# ── Audit + analytics ────────────────────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_POSITION_INTERVAL_MS=60000   # POSITION rows are one a minute, not one per 5 s
ANALYTICS_RETENTION_DAYS=90
