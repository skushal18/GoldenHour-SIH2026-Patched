# =============================================================================
# GoldenHour backend configuration (v6)
#
# Copy to backend/.env and edit, or set these in Railway's Variables tab.
# This file is safe to commit; .env is not, and .gitignore keeps it out.
#
# With NODE_ENV=production the server AUDITS this configuration at boot and
# REFUSES TO START if anything would be unsafe in a real deployment. It prints
# exactly what to change and exits 78.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5000
# development (default) | production
NODE_ENV=development


# ── Persistence ──────────────────────────────────────────────────────────────
# auto   — try MySQL, fall back to in-memory with a loud warning (development)
# memory — always in-memory; nothing survives a restart (demo)
# mysql  — require MySQL; an unreachable database is a failed start
# Production MUST be mysql.
DB_DRIVER=auto

# The server creates its own tables at startup (and never drops any) — there
# is no schema to load by hand. Connection settings, first match wins:
#   1. DATABASE_URL / MYSQL_URL / MYSQL_PUBLIC_URL   mysql://user:pass@host:port/db
#      (Railway's MySQL plugin injects MYSQL_URL — reference it, nothing else to do)
#   2. MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE  (Railway)
#   3. the DB_* variables below
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goldenhour
# DB_SSL=true            # require TLS to the database
# DB_POOL_SIZE=10


# ── Hospital sign-in ─────────────────────────────────────────────────────────
# jwt (default) — every ER desk signs in; its hospital comes from its login.
# ip            — LAN rehearsal only: identity from ?hospital=<id> or the IP.
#                 Anyone can claim to be anyone. Refused in production.
DESK_AUTH=jwt

# Signs sign-in tokens. Required in production (32+ characters, never a value
# that has appeared in this repository). Unset in development = a random
# secret per run, so desks are signed out whenever the server restarts.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts (an ER wall screen re-signs-in after this).
JWT_TTL=12h

# First administrator, created only when the database has none. The password
# is flagged for change at first sign-in. Remove these after first boot.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Development/demo only (ignored in production): an empty store gets an
# "admin" login and logins for two Bengaluru hospitals, passwords printed
# once in the log. DEMO_PASSWORD fixes them for a rehearsed demo;
# DEMO_HOSPITAL_IDS picks other directory hospitals; DEMO_SEED=false skips it.
DEMO_SEED=true
DEMO_PASSWORD=
DEMO_HOSPITAL_IDS=

# Only meaningful with DESK_AUTH=ip. Set false to switch ?hospital=<id> off.
ALLOW_MANUAL_HOSPITAL_OVERRIDE=true


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. The ER desk
# and the web ambulance app are served by this server (same origin) and need
# nothing here; the Android APK runs from https://localhost.
#   CORS_ORIGIN=https://localhost,https://goldenhour.example
# Blank means "any origin": fine on a LAN, refused in production.
CORS_ORIGIN=


# ── Broadcasts and the hospital directory ────────────────────────────────────
# true  — every hospital with an active login is alerted, whatever the
#         distance (demo: works wherever the judges are).
# false — hospitals with an active login inside the crew's radius.
# Production requires false.
HACKATHON_MODE=true

# How long a broadcast stays open before it expires unanswered.
ACCEPT_WINDOW_SECONDS=180

# Repeat POSTs with the same X-Client-Request-Id return the original case and
# crew token instead of creating a second case.
REQUEST_IDEMPOTENCY_TTL_MS=1800000

# The all-India directory ships at data/hospitals/india_hospitals.csv.
# HOSPITAL_DIRECTORY_FILE=/path/to/another.csv


# ── Live tracking ────────────────────────────────────────────────────────────
TRACK_MIN_INTERVAL_MS=5000     # server-side floor between accepted positions
TRACK_MAX_POINTS=120           # ring buffer per case
TRACK_STALL_SECONDS=90         # below TRACK_STALL_KMH this long → "not moving"
TRACK_STALL_KMH=5
TRACK_SPEED_MIN_KMH=15         # ETA clamp: a stopped ambulance is not a 4-hour ETA
TRACK_SPEED_MAX_KMH=80         # ETA clamp: a GPS jump is not a 30-second ETA
TRACK_ETA_ROAD_FACTOR=1.25     # straight-line distance → road distance

# Map tiles the ER desk may load (content security policy). The tile URL
# itself is set in backend/public/hospital/config.js.
MAP_TILE_HOSTS=https://tile.openstreetmap.org https://*.tile.openstreetmap.org


# ── Capacity, audit, analytics ───────────────────────────────────────────────
CAPACITY_STALE_MINUTES=60      # older than this is marked stale and scored down
AUDIT_POSITION_INTERVAL_MS=60000
ANALYTICS_RETENTION_DAYS=90
