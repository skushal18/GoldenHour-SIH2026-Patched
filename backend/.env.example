# ── GoldenHour backend ──────────────────────────────────────────────────────
# Copy to `.env` and edit. The two hospital laptop IPs do NOT live here —
# they are in config/hospitals.config.js at the repo root.
#
# Full deployment walkthrough: DEPLOYMENT.md

PORT=5000

# ── Storage ─────────────────────────────────────────────────────────────────
# auto   try MySQL, fall back to an in-memory store so a demo always runs
# mysql  require MySQL, refuse to start without it   ← use this in production
# memory skip MySQL entirely (same as `npm run demo`)
DB_DRIVER=auto

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_sql_password
DB_NAME=goldenhour
DB_PORT=3306

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate a real one before this leaves your machine:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=goldenhour_2026

# ── ER desk security ────────────────────────────────────────────────────────
# ip   (default) a laptop's IP address is its credential. Correct for a closed
#      hackathon LAN, unacceptable on anything reachable from the internet.
# jwt  a signed token decides which hospital a board is. Identity comes from
#      the token, so ?hospital=2 cannot forge it.   ← use this in production
DESK_AUTH=ip

# ── CORS ────────────────────────────────────────────────────────────────────
# Empty means "any origin", which is fine on a LAN and wrong in public.
# Comma-separated list of exact origins, e.g.
#   CORS_ORIGIN=https://goldenhour.example.org
CORS_ORIGIN=
